{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "dependencyDashboard": true,
    // 1. DISABLE the standard pip manager for this file so it doesn't fight with uv
    "pip_requirements": {
        "enabled": false
    },
    // 2. CONFIGURE the compiler manager to handle your devcontainer
    "pip-compile": {
        "enabled": true,
        // Renovate watches the input file (.in), not the output file (.txt)
        "fileMatch": [
            "^\\.devcontainer/requirements\\.in$"
        ],
        "managerRunner": "uv-pip-compile"
    },
    "packageRules": [
        {
            // Update the manager matcher to look for pip-compile
            "matchManagers": [
                "pip-compile"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "devcontainer non-major dependencies",
            "groupSlug": "devcontainer-non-major"
        },
        {
            "matchManagers": [
                "pip-compile"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": "devcontainer major dependencies",
            "groupSlug": "devcontainer-major"
        }
    ],
    "schedule": [
        "at any time"
    ],
    "assignees": [
        "robertobernabe"
    ],
    "labels": [
        "dependencies"
    ]
}