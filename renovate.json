{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "dependencyDashboard": true,
    "pip_requirements": {
        "enabled": false
    },
    "pip-compile": {
        "enabled": true,
        "fileMatch": [
            "^\\.devcontainer/requirements\\.txt$"
        ]
    },
    "packageRules": [
        {
            "matchManagers": [
                "pip-compile"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "devcontainer non-major dependencies",
            "groupSlug": "devcontainer-non-major"
        },
        {
            "matchManagers": [
                "pip-compile"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": "devcontainer major dependencies",
            "groupSlug": "devcontainer-major"
        }
    ],
    "schedule": [
        "at any time"
    ],
    "assignees": [
        "robertobernabe"
    ],
    "labels": [
        "dependencies"
    ]
}